# ==============================================================================
# ARLETEX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables to match your local setup:
#   cp .env.example .env
#
# Target Architecture: Linux (Bazzite / Fedora / Ubuntu) on AMD x86_64
# Reference Device: ASUS ROG Ally X (Ryzen Z1 Extreme, 24GB LPDDR5X, Radeon 780M)
# ==============================================================================

# ==============================================================================
# 1. CORE HOST & BACKEND SERVER
# ==============================================================================
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Arletex Fastify Backend HTTP/REST & WebSocket Server Port
ARLETEX_PORT=39281

# Secret Bearer token for loopback API authentication (header: 'x-arletex-auth').
# In development, leave blank for open loopback access. For production, set a strong random secret.
ARLETEX_AUTH_TOKEN=

# Enforce loopback authentication strictly even in development/test mode (0 or 1)
ARLETEX_ENFORCE_AUTH=0

# Root persistent storage directory for SQLite database, memories, and media assets
ARLETEX_DATA_DIR=/home/user/.arletex

# Backend logging level: 'debug', 'info', 'warn', 'error'
ARLETEX_LOG_LEVEL=info


# ==============================================================================
# 2. ARLE'S PERSONA, IDENTITY & DIGITAL ACCOUNTS
# ==============================================================================
# Arle's dedicated personal email address
ARLETEX_EMAIL=arle.personal@gmail.com
ARLETEX_EMAIL_ADDRESS=arle.personal@gmail.com

# App-specific password for autonomous email checking & drafting (IMAP/SMTP)
ARLETEX_EMAIL_PASSWORD=

# Optional Google Workspace / Gmail OAuth2 access token
ARLETEX_EMAIL_OAUTH_TOKEN=

# Dedicated Google Chrome profile folder for Arle's web browsing, Spotify, and YouTube
# Note: Keep in double quotes to preserve spaces!
ARLETEX_CHROME_PROFILE="Profile 1"

# Custom path to Google Chrome / Chromium executable (auto-detected if blank)
CHROMIUM_PATH=


# ==============================================================================
# 3. COGNITIVE LANGUAGE INFERENCE GATEWAY (UNCENSORED PRIMARY & FALLBACK)
# ==============================================================================
# Model Tier Selection: "9b" or "14b"
# Simply change this single variable to switch between models:
# - "9b":  Fastest (~30 tps), low VRAM (~5.5GB), enables Multimodal Screen Vision via mmproj
# - "14b": Deeper nuance (~15 tps), higher VRAM (~9GB), text-only reasoning
ARLETEX_MODEL_TIER=9b

# Primary LLM provider: 'llama.cpp' (Vulkan on AMD iGPU) or 'colibri' (MoE)
ARLETEX_INFERENCE_PROVIDER=llama.cpp

# Primary llama.cpp HTTP daemon endpoint
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Primary Uncensored Model Identifier
LLAMA_MODEL_ID=Qwen3.5-9B-Heretic-Q4_K_M

# Local filesystem path to model weights file (.gguf) for scripts/start-llama-server.sh
# (Automatically resolved by ARLETEX_MODEL_TIER above, or specify custom path here)
ARLETEX_MODEL_PATH=/home/user/models/qwen-heretic/Qwen3.5-9B-Heretic-Q4_K_M.gguf

# Multimodal Vision Projector file (.gguf) for visual reasoning & screen inspection (auto-resolved for 9b)
MMPROJ_PATH=/home/user/models/qwen-heretic/Qwen3.5-9B-mmproj-BF16.gguf

# Enable automatic fallback to secondary model when primary is unavailable or times out
ARLETEX_INFERENCE_FALLBACK=true

# Fallback model identifier
LLAMA_FALLBACK_MODEL_ID=Qwen2.5-14B-Instruct-abliterated-v2.Q4_K_M

# Alternative Colibri MoE daemon endpoint (optional)
COLIBRI_SERVER_URL=http://127.0.0.1:8000
COLIBRI_MODEL_ID=qwen3.6-colibri


# ==============================================================================
# 4. SPECIALIST CODING MICROSERVICE (PORT 8001)
# ==============================================================================
# Dedicated coding model service (disabled by default; uses primary cognitive model)
SPECIALIST_CODING_ENABLED=false
SPECIALIST_CODING_PROVIDER=llama.cpp
SPECIALIST_CODING_URL=http://127.0.0.1:8001
SPECIALIST_CODING_MODEL=Qwen3.5-9B-Heretic-Q4_K_M


# ==============================================================================
# 5. SPECIALIST MULTIMODAL PYTHON MICROSERVICES (PORT 39282)
# ==============================================================================
# Python microservices daemon endpoint for EmbeddingGemma, Whisper, Kokoro, RVC, GLM-OCR
ARLETEX_SPECIALISTS_URL=http://127.0.0.1:39282

# Port used when spawning the Python specialists daemon
ARLETEX_SPECIALISTS_PORT=39282

# Directory containing local specialist neural model weights
ARLETEX_SPECIALISTS_DIR=/home/user/models/arle-specialists

# Path to Python interpreter within the virtual environment (.venv)
ARLETEX_PYTHON=.venv/bin/python

# Path to the specialist microservice entry script
ARLETEX_SPECIALISTS_SCRIPT=apps/desktop/py-services/specialists_server.py


# ==============================================================================
# 6. EMOTION-AWARE VOICE SYSTEM & ACOUSTIC EXPRESSION
# ==============================================================================
# Master voice toggle: enable expressive vocal output
ARLE_VOICE_ENABLED=true

# Speech synthesis engine: 'kokoro' (real-time sub-second synthesis on CPU) or 'qwen3-tts' (high-fidelity neural acting, ~16s/phrase on CPU)
ARLE_VOICE_ENGINE=kokoro

# Target vocal identity profile (Arlecchino-inspired mature feminine timbre)
ARLE_VOICE_TIMBRE=arlecchino_mature_husky

# Enable 1:1 RVC voice conversion (Arlecchino 500e acoustic profile)
ARLETEX_ENABLE_RVC=1

# Base speech pacing multiplier (0.8 to 1.2x)
ARLE_VOICE_DEFAULT_PACE=1.0

# Base pitch modulation delta (-0.3 to +0.3)
ARLE_VOICE_DEFAULT_PITCH=0.0


# ==============================================================================
# 7. WHATSAPP COMMUNICATION ADAPTER (GoWA STANDALONE DAEMON)
# ==============================================================================
# Master toggle for WhatsApp integration
ARLE_WHATSAPP_ENABLED=false

# Local GoWA standalone daemon REST API endpoint
ARLE_WHATSAPP_BASE_URL=http://127.0.0.1:3000

# GoWA REST API Basic Authentication credentials
ARLE_WHATSAPP_USERNAME=admin
ARLE_WHATSAPP_PASSWORD=admin123

# GoWA multi-device session identifier
ARLE_WHATSAPP_DEVICE_ID=default

# Shared HMAC-SHA256 secret for validating inbound webhook signatures
ARLE_WHATSAPP_WEBHOOK_SECRET=your-gowa-webhook-secret-key

# Owner WhatsApp JID (phone number) authorized to send commands/dialogue to Arle
# Format: <country_code><number>@s.whatsapp.net (e.g. 15551234567@s.whatsapp.net)
ARLE_WHATSAPP_OWNER_JID=

# Allow Arle to autonomously respond to incoming WhatsApp messages from the owner
ARLE_WHATSAPP_AUTO_REPLY=true

# Outbound message rate limit (messages per minute)
ARLE_WHATSAPP_RATE_LIMIT=30


# ==============================================================================
# 8. TELEGRAM REMOTE COMMUNICATION
# ==============================================================================
# Telegram Bot API token from @BotFather for remote communication
TELEGRAM_BOT_TOKEN=

# Owner's authenticated numeric Telegram Chat ID for private dialogue & notifications
TELEGRAM_TARGET_CHAT_ID=


# ==============================================================================
# 9. EMBODIED LINUX DESKTOP & TARGET HARDWARE ACCELERATION
# ==============================================================================
# Path to compiled C++20 native reflex engine binary for ultra-fast screen/input
REFLEX_ENGINE_PATH=native/build/reflex_engine

# Wayland display socket name (standard on Bazzite/KDE Wayland)
WAYLAND_DISPLAY=wayland-1

# User runtime directory for Wayland / D-Bus communication
XDG_RUNTIME_DIR=/run/user/1000

# GPU layer offload to AMD Radeon 780M via Vulkan (36 layers for 14B, 28 for 9B)
N_GPU_LAYERS=36

# Model context token budget (8192 for 14B, 4096 for 9B)
CTX_SIZE=8192
