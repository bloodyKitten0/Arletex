# ==============================================================================
# Arletex Environment Configuration Template
# Copy to .env and adjust variables as desired.
# ==============================================================================

# --- Arle's Personal Digital Identity & Email ---
# Change this to your custom email address for Arle:
ARLETEX_EMAIL=example.email@gmail.com
ARLETEX_EMAIL_ADDRESS=example.email@gmail.com

# --- Dedicated Google Chrome Profile ---
# Chrome profile directory used for Arle's browsing, Spotify, and web apps:
ARLETEX_CHROME_PROFILE=Profile N

# --- Cognitive Inference Server (llama.cpp) ---
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_MODEL_ID=Qwen2.5-14B-Instruct-abliterated-v2.Q4_K_M

# --- Specialist Multimodal Microservices (EmbeddingGemma, Whisper, Kokoro) ---
ARLETEX_SPECIALISTS_URL=http://127.0.0.1:39282

# --- Storage and Runtime Paths ---
ARLETEX_DATA_DIR=/home/user/.arletex
ARLETEX_LOG_LEVEL=info
